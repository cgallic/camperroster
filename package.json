{
  "name": "camperroster",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\" tests/*.test.mjs",
    "test:import": "python scripts/test_import_camp_workbooks.py",
    "test:private-cache": "node scripts/test-private-cache.cjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "validate:env": "node scripts/validate-env.mjs",
    "ops:storage": "node --experimental-strip-types scripts/setup-storage.ts",
    "ops:grant-access": "node --experimental-strip-types scripts/grant-access.ts",
    "verify": "npm run typecheck && npm test && npm run test:import && npm run test:private-cache && npm run check:migrations && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.112.4",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "nodemailer": "^10.0.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.6.2",
    "tailwind-merge": "^2.5.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
