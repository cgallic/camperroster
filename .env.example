# Supabase — project URL and publishable (anon) key are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses row-level security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Operations only: direct Postgres connection for additive migration/import
# tooling. Never expose it to browser code.
DATABASE_URL=

# Stripe
STRIPE_SECRET_KEY=
# Reserved for a future embedded Stripe.js checkout. Current checkout routes
# redirect to Stripe-hosted pages and do not read this variable.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Two endpoints are registered with Stripe and each has its own signing secret.
# Verifying one endpoint's delivery with the other's secret fails every time.
STRIPE_WEBHOOK_SECRET=          # /api/stripe/webhook  — families paying tuition
STRIPE_BILLING_WEBHOOK_SECRET=  # /api/billing/webhook — camps paying for the product

# Stripe Price ids for the camp subscription plans
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Public origin used in payment return URLs. Production must be HTTPS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Registration session fallback. Per-session overrides use the submitted slug:
# CAMP_SESSION_ID_SESSION_2, CAMP_SESSION_ID_JUNIOR_WEEK, and so on.
CAMP_SESSION_ID=

# Transactional mail and the authenticated mail-dispatch cron.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
CRON_SECRET=

# Internal notification target for new registrations and volunteer applications.
INBOUND_WEBHOOK_URL=

# Optional. Defaults to false when omitted.
PASS_PROCESSING_FEES_TO_FAMILIES=false

# Legacy/default camp label retained for import tooling; tenant-facing routes
# resolve camps from the database and must not trust this as authorization.
CAMP_SLUG=camphope
