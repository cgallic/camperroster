# Supabase — project URL and publishable (anon) key are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses row-level security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Signs the one-hour registration capability used for public uploads/checkout.
PUBLIC_INTAKE_TOKEN_SECRET=

# KaiCalls: x-kaicalls-timestamp + x-kaicalls-signature (sha256 HMAC).
KAICALLS_WEBHOOK_SECRET=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Two endpoints are registered with Stripe and each has its own signing secret.
# Verifying one endpoint's delivery with the other's secret fails every time.
STRIPE_WEBHOOK_SECRET=          # /api/stripe/webhook  — families paying tuition
STRIPE_BILLING_WEBHOOK_SECRET=  # /api/billing/webhook — camps paying for the product

# Stripe Price ids for the camp subscription plans
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Camp defaults used by public intake routes
CAMP_SLUG=camphope
NEXT_PUBLIC_SITE_URL=http://localhost:3000
